{{define "message"}}<div class="msg {{.Kind}}" data-seq="{{.Seq}}" data-sender="{{.SenderID}}"><div class="m-content"><span class="m-meta">[{{.Seq}} {{ts .CreatedAt}}] <b title="{{.SenderID}}">{{if .SenderName}}{{.SenderName}}{{else}}{{.SenderID}}{{end}}</b>{{if ne .Kind "chat"}} <i class="kind">{{.Kind}}</i>{{end}}</span>{{if .ReadTotal}}<span class="m-read{{if eq .ReadCount .ReadTotal}} all{{end}}" title="{{.ReadTip}}">✓{{.ReadCount}}/{{.ReadTotal}}</span>{{end}} {{.Content}}</div></div>{{end}}
{{define "participants"}}<div id="participants"><h3>Participants</h3><ul>{{range .Agents}}<li class="{{if agentOnline .}}p-online{{else}}p-offline{{end}}"{{if or .Hostname .Workdir}} title="{{if .Hostname}}{{.Hostname}} · {{end}}{{.Workdir}}"{{end}}><span class="id">{{.DisplayName}}</span>{{if $.CanRemove}}<form method="post" action="/panel/sessions/{{$.SessionID}}/participants/{{.ID}}/remove" class="inline"><button type="submit" class="rowbtn" aria-label="Remove {{.DisplayName}} from this session" title="Remove from this session — {{.DisplayName}} stays registered and keeps its other sessions" onclick="return confirm('Remove {{.DisplayName}} from this session? They stay registered and keep their other sessions.')">{{template "icon-x"}}</button></form>{{end}}{{if .Workdir}}<small>{{.Workdir}}</small>{{end}}</li>{{else}}<li>none</li>{{end}}</ul></div>{{end}}
{{/* Inline icons for the dashboard's session actions (no icon font, no
     build step): 16px stroke drawings that inherit the button's color. */}}
{{define "icon-archive"}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg>{{end}}
{{define "icon-restore"}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14l-4-4l4-4"/><path d="M5 10h11a4 4 0 1 1 0 8h-1"/></svg>{{end}}
{{define "icon-trash"}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2l1-12"/><path d="M9 7V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3"/></svg>{{end}}
{{define "icon-lock"}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>{{end}}
{{define "icon-x"}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12"/><path d="M18 6L6 18"/></svg>{{end}}
