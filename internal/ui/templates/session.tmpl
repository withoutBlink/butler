<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Butler — {{.Session.Title}}</title>
<link rel="stylesheet" href="{{asset "style.css"}}">
</head>
<body>
<header>
<span class="brand">Butler</span>
<nav>
<a href="/panel/">&larr; Sessions</a>
<span class="session-title">{{.Session.Title}} <small>[{{.Session.Status}}]</small></span>
</nav>
{{if not .Global}}<span class="session-actions"><form method="post" action="/panel/sessions/{{.Session.ID}}/status" class="inline"><input type="hidden" name="from" value="session"><input type="hidden" name="status" value="{{if .Archived}}active{{else}}archived{{end}}"><button type="submit" class="link" title="{{if .Archived}}Reopen this session (posting and joining work again){{else}}Archive this session: it stays readable but frozen — no posts, context writes or joins until reopened{{end}}">{{if .Archived}}reopen{{else}}archive{{end}}</button></form><form method="post" action="/panel/sessions/{{.Session.ID}}/delete" class="inline"><button type="submit" class="link danger" title="Delete this session permanently — its messages, participants and context go with it" onclick="return confirm('Delete session “{{.Session.Title}}” permanently? Its messages, participants and context are gone for good.')">delete</button></form></span>{{end}}
</header>
{{if .Archived}}<p class="archived-banner">Archived — this session is frozen: no posts, context writes or new participants until you reopen it.</p>{{end}}
<main class="session-layout">
<aside class="sidebar">
{{template "participants" .Participants}}
{{if .Archived}}
<p class="hint">Archived — reopen the session to add participants or set context.</p>
{{else if .Addable}}
<form method="post" action="/panel/sessions/{{.Session.ID}}/join" class="context-form join-form">
<h3>Add to meeting</h3>
<select name="agent" required aria-label="Role to add">
{{range .Addable}}<option value="{{.ID}}" title="{{.ID}}">{{.Title}} · {{.Kind}}</option>{{end}}
</select>
<button type="submit">Add participant</button>
</form>
{{else}}
<p class="hint">No other connected roles to add — every visible role is already in this meeting.</p>
{{end}}
<section class="context">
<h3>Context</h3>
<dl>
{{range .ContextItems}}<dt>{{.Key}}</dt><dd>{{.Value}}</dd>{{else}}<dt>none set</dt>{{end}}
</dl>
{{if not .Archived}}<form method="post" action="/panel/sessions/{{.Session.ID}}/context" class="context-form">
<input type="text" name="key" placeholder="key" required>
<textarea name="value" placeholder="value" required></textarea>
<button type="submit">Set context</button>
</form>{{end}}
</section>
</aside>
<section class="chat-pane">
<div id="messages" data-stream="/panel/sessions/{{.Session.ID}}/stream?after={{.LatestSeq}}" data-agents="{{.Agents}}" data-reads="{{.Reads}}">
{{range .Messages}}{{template "message" .}}{{end}}
</div>
{{if .Archived}}<p class="hint compose-hint">Archived — reopen the session to post again.</p>{{else}}<form id="compose" method="post" action="/panel/sessions/{{.Session.ID}}/messages">
<textarea name="content" placeholder="Send a message as admin… (type @ to mention agents)" required data-mentionables="{{.Mentionables}}"></textarea>
<button type="submit">Send</button>
</form>{{end}}
</section>
</main>
<script src="{{asset "app.js"}}"></script>
</body>
</html>
