{{define "htmx"}}<script src="{{asset "vendor/htmx.min.js"}}"></script>
<script src="{{asset "vendor/sse.js"}}"></script>{{end}}
{{define "activity"}}{{if .State}}<span class="presence p-{{.State}}" title="{{.Title}}"><span class="act act-{{.State}}" aria-hidden="true"></span><span class="act-label">{{.State}}</span></span>{{end}}{{end}}
{{define "message"}}<div class="msg {{.Kind}}{{if .Long}} clip{{end}}" id="msg-{{.Seq}}" data-seq="{{.Seq}}" data-sender="{{.SenderID}}">{{if .Long}}<input type="checkbox" id="expand-{{.Seq}}" class="expand-toggle">{{end}}<div class="m-content"><span class="m-meta">[{{.Seq}} {{ts .CreatedAt}}] <span id="act-{{.Seq}}">{{template "activity" .Activity}}</span><b title="{{.SenderID}}">{{if .SenderName}}{{.SenderName}}{{else}}{{.SenderID}}{{end}}</b>{{if ne .Kind "chat"}} <i class="kind">{{.Kind}}</i>{{end}}</span>{{if eq .Kind "chat"}}<span id="read-{{.Seq}}" class="m-read{{if and .ReadTotal (eq .ReadCount .ReadTotal)}} all{{end}}" title="{{.ReadTip}}"{{if not .ReadTotal}} hidden{{end}}>{{if .ReadTotal}}✓{{.ReadCount}}/{{.ReadTotal}}{{end}}</span>{{end}} {{.Content}}</div>{{if .Long}}<label class="expand-label" for="expand-{{.Seq}}"><span class="when-clamped">more</span><span class="when-open">less</span></label>{{end}}</div>{{end}}
{{define "live-reads"}}{{range .}}{{if eq .Kind "chat"}}<span id="read-{{.Seq}}" hx-swap-oob="outerHTML" class="m-read{{if and .ReadTotal (eq .ReadCount .ReadTotal)}} all{{end}}" title="{{.ReadTip}}"{{if not .ReadTotal}} hidden{{end}}>{{if .ReadTotal}}✓{{.ReadCount}}/{{.ReadTotal}}{{end}}</span>{{end}}{{end}}{{end}}
{{define "live-activity"}}{{range .}}<span id="act-{{.Seq}}" hx-swap-oob="outerHTML">{{template "activity" .Activity}}</span>{{end}}{{end}}
{{define "composer"}}<textarea id="composer" name="content" placeholder="Send a message as admin… (type @ to mention agents)" required {{if .OOB}}hx-swap-oob="outerHTML"{{end}}{{if .Focus}} autofocus{{end}} hx-post="/panel/sessions/{{.SessionID}}/mentions" hx-trigger="keyup changed delay:200ms" hx-target="#mention-menu" hx-swap="innerHTML" hx-params="content">{{.Value}}</textarea>{{end}}
{{define "mention-menu"}}{{if .Items}}<div class="mention-menu">{{range .Items}}<button type="button" class="mention-item" hx-post="/panel/sessions/{{$.SessionID}}/mentions/apply" hx-include="#composer" hx-vals="{{.Vals}}" hx-target="#oob" hx-swap="innerHTML">@{{.Name}}</button>{{end}}</div>{{end}}{{end}}
{{define "mention-clear"}}<div id="mention-menu" hx-swap-oob="innerHTML"></div>{{end}}
{{define "participants"}}<div id="participants"><h3>Participants</h3><ul>{{range .Agents}}<li data-agent="{{.ID}}" data-since="{{.JoinedSeq}}"{{if or .Hostname .Workdir}} title="{{if .Hostname}}{{.Hostname}} · {{end}}{{.Workdir}}"{{end}}><span class="who">{{template "activity" .Activity}}<span class="id">{{.DisplayName}}</span></span>{{if $.CanRemove}}<button type="button" class="rowbtn" popovertarget="rm-{{$.SessionID}}-{{.ID}}" aria-label="Remove {{.DisplayName}} from this session" title="Remove from this session — {{.DisplayName}} stays registered and keeps its other sessions">{{template "icon-x"}}</button><div id="rm-{{$.SessionID}}-{{.ID}}" popover class="confirm"><p>Remove {{.DisplayName}} from this session? They stay registered and keep their other sessions.</p><form method="post" action="/panel/sessions/{{$.SessionID}}/participants/{{.ID}}/remove"><button type="submit">Remove</button><button type="button" popovertarget="rm-{{$.SessionID}}-{{.ID}}" popovertargetaction="hide">Cancel</button></form></div>{{end}}{{if .Workdir}}<small>{{.Workdir}}</small>{{end}}</li>{{else}}<li>none</li>{{end}}</ul></div>{{end}}
{{/* Inline icons for the dashboard's session actions (no icon font, no
     build step): 16px stroke drawings that inherit the button's color. */}}
{{define "icon-archive"}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg>{{end}}
{{define "icon-restore"}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14l-4-4l4-4"/><path d="M5 10h11a4 4 0 1 1 0 8h-1"/></svg>{{end}}
{{define "icon-trash"}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2l1-12"/><path d="M9 7V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3"/></svg>{{end}}
{{define "icon-lock"}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>{{end}}
{{define "icon-x"}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12"/><path d="M18 6L6 18"/></svg>{{end}}
