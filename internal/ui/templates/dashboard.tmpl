<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Butler</title>
<link rel="stylesheet" href="{{asset "style.css"}}">
</head>
<body>
<header>
<span class="brand">Butler</span>
<nav>
<a href="/panel/board">Board</a>
<form method="post" action="/panel/logout" class="inline"><button type="submit" class="link">Sign out</button></form>
</nav>
</header>
<main class="dashboard">
{{if .Notice}}<p class="notice">{{.Notice}}</p>{{end}}
<section class="new-session">
<h2>New session</h2>
<form method="post" action="/panel/sessions" class="new-session-form">
<input type="text" name="title" placeholder="Session title, e.g. “fix flaky integration tests”" required maxlength="200">
{{if .Pickable}}<input type="search" name="pick" class="pick-filter" placeholder="Filter teammates" autocomplete="off" hx-get="/panel/picks" hx-trigger="keyup changed delay:200ms, search" hx-target="#picks" hx-swap="innerHTML" hx-include="this, #picks">
<div id="picks">{{template "picks" .Picks}}</div>{{else}}<span class="hint">no agents registered yet — sessions with only you still work</span>{{end}}
<button type="submit">Create session</button>
</form>
</section>
<section class="sessions">
<h2>Sessions</h2>
<table>
<tr><th>Title</th><th>Status</th><th>Participants</th><th>Last activity</th><th></th></tr>
{{range .Sessions}}
<tr{{if ne .Session.Status "active"}} class="archived"{{end}}>
<td><a href="/panel/sessions/{{.Session.ID}}">{{.Session.Title}}</a>{{if .LastPreview}}<div class="preview">{{short .LastPreview}}</div>{{end}}</td>
<td>{{.Session.Status}}</td>
<td class="participants">{{if not .Shown}}—{{else}}<ul class="part-list">{{range .Shown}}{{template "part-line" .}}{{end}}{{if .More}}<li><details class="part-more"><summary>{{.MoreLabel}}</summary><ul class="part-list">{{range .More}}{{template "part-line" .}}{{end}}</ul></details></li>{{end}}</ul>{{end}}</td>
<td>{{if .LastAt}}{{ts .LastAt}}{{else}}—{{end}}</td>
<td class="sess-actions">{{if .Global}}<span class="fixed-ico" title="The global session is fixed: every agent joins it, and it cannot be archived or deleted">{{template "icon-lock"}}</span>{{else}}<form method="post" action="/panel/sessions/{{.Session.ID}}/status" class="inline"><input type="hidden" name="status" value="{{if ne .Session.Status "active"}}active{{else}}archived{{end}}"><button type="submit" class="iconbtn" aria-label="{{if ne .Session.Status "active"}}Reopen session{{else}}Archive session{{end}}" title="{{if ne .Session.Status "active"}}Reopen this session (posting and joining work again){{else}}Archive this session: it stays readable but frozen — no posts, context writes or joins until reopened{{end}}">{{if ne .Session.Status "active"}}{{template "icon-restore"}}{{else}}{{template "icon-archive"}}{{end}}</button></form><button type="button" class="iconbtn danger" popovertarget="del-{{.Session.ID}}" aria-label="Delete session" title="Delete this session permanently — its messages, participants and context go with it">{{template "icon-trash"}}</button><div id="del-{{.Session.ID}}" popover class="confirm"><p>Delete session “{{.Session.Title}}” permanently? Its messages, participants and context are gone for good.</p><form method="post" action="/panel/sessions/{{.Session.ID}}/delete"><button type="submit">Delete</button><button type="button" popovertarget="del-{{.Session.ID}}" popovertargetaction="hide">Cancel</button></form></div>{{end}}</td>
</tr>
{{else}}<tr><td colspan="5">no sessions yet</td></tr>{{end}}
</table>
</section>
<section class="agents">
<h2>Agents</h2>
<div class="agents-scroll">
<table>
<colgroup><col class="c-act"><col class="c-kind"><col class="c-title"><col class="c-host"><col class="c-dir"><col class="c-seen"><col class="c-kick"></colgroup>
<thead><tr><th>Activity</th><th>Kind</th><th>Title</th><th>Host</th><th>Working directory</th><th>Seen</th><th></th></tr></thead>
<tbody>
{{range .Roster}}
<tr>
<td>{{template "activity" .Activity}}</td>
<td class="clip" title="{{.Kind}}">{{.Kind}}</td>
<td><div class="clip" title="{{.Tip}}"><span class="id">{{if .Title}}{{.Title}}{{else}}—{{end}}</span>{{if .Invite}} <span class="default-tag" title="{{.Invite}}">{{.Invite}}</span>{{end}}</div>
{{if .Live}}<details class="live" open><summary>{{.LiveLabel}}</summary><ul class="session-list">{{range .Live}}{{template "roster-row" .}}{{end}}</ul></details>{{end}}
{{if .Earlier}}<details class="earlier"><summary>{{.EarlierLabel}}</summary><ul class="session-list">{{range .Earlier}}{{template "roster-row" .}}{{end}}</ul></details>{{end}}
</td>
<td class="clip" title="{{.Hostname}}">{{if .Hostname}}{{.Hostname}}{{else}}—{{end}}</td>
<td class="id clip" title="{{.Workdir}}">{{if .Workdir}}{{.Workdir}}{{else}}—{{end}}</td>
<td>{{.LastTxt}}</td>
<td>{{if .Kick}}{{template "roster-kick" .}}{{end}}</td>
</tr>
{{else}}<tr><td colspan="7">none</td></tr>{{end}}
</tbody>
</table>
</div>
</section>
</main>
{{template "htmx" .}}
</body>
</html>
