<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Butler</title>
<link rel="stylesheet" href="{{asset "style.css"}}">
</head>
<body>
<header>
<span class="brand">Butler</span>
<nav>
<a href="/panel/">Sessions</a>
<form method="post" action="/panel/logout" class="inline"><button type="submit" class="link">Sign out</button></form>
</nav>
</header>
<main class="dashboard">
<section class="new-session">
<h2>New session</h2>
<form method="post" action="/panel/sessions" class="new-session-form">
<input type="text" name="title" placeholder="Session title, e.g. “fix flaky integration tests”" required maxlength="200">
<div class="picks">
{{range .Agents}}{{if ne .ID "admin"}}<label class="pick" title="{{.ID}}"><input type="checkbox" name="agents" value="{{.ID}}"> <span class="id">{{if .Title}}{{.Title}}{{else}}{{.ID}}{{end}}</span></label>
{{end}}{{end}}{{if .Pickable}} {{else}}<span class="hint">no agents registered yet — sessions with only you still work</span>{{end}}
</div>
<button type="submit">Create session</button>
</form>
</section>
<section class="sessions">
<h2>Sessions</h2>
<table>
<tr><th>Title</th><th>Status</th><th>Participants</th><th>Last activity</th></tr>
{{range .Sessions}}
<tr>
<td><a href="/panel/sessions/{{.Session.ID}}">{{.Session.Title}}</a>{{if .LastPreview}}<div class="preview">{{short .LastPreview}}</div>{{end}}</td>
<td>{{.Session.Status}}</td>
<td>{{range $i, $p := .Participants}}{{if $i}}, {{end}}<span class="id" title="{{$p.ID}}">{{$p.DisplayName}}</span>{{end}}</td>
<td>{{if .LastAt}}{{ts .LastAt}}{{else}}—{{end}}</td>
</tr>
{{else}}<tr><td colspan="4">no sessions yet</td></tr>{{end}}
</table>
</section>
<section class="agents">
<h2>Agents</h2>
<table>
<tr><th></th><th>Kind</th><th>Title</th><th>Host</th><th>Working directory</th><th>Seen</th><th></th></tr>
{{range .Agents}}
<tr>
<td><span class="dot{{if .Online}} on{{end}}"></span></td>
<td>{{.Kind}}</td>
<td>{{if .Title}}{{.Title}}{{else}}—{{end}}{{if .Sub}}<div class="sub id">{{.Sub}}</div>{{end}}</td>
<td>{{if .Hostname}}{{.Hostname}}{{else}}—{{end}}</td>
<td class="id" title="{{.Workdir}}">{{if .Workdir}}{{path .Workdir}}{{else}}—{{end}}</td>
<td>{{.LastTxt}}</td>
<td>{{if ne .ID "admin"}}<form method="post" action="/panel/agents/{{.ID}}/revoke" class="inline"><button type="submit" class="kick" title="Revoke this agent's tokens — its live processes get 401 until they re-register" onclick="return confirm('Kick {{.ID}}? Its live processes will be disconnected until they re-register.')">kick</button></form>{{end}}</td>
</tr>
{{else}}<tr><td colspan="7">none</td></tr>{{end}}
</table>
</section>
</main>
</body>
</html>
