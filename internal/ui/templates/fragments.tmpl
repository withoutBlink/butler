{{define "message"}}<div class="msg {{.Kind}}" data-seq="{{.Seq}}"><div class="m-meta">[{{.Seq}} {{ts .CreatedAt}}] <b>{{.SenderID}}</b>{{if ne .Kind "chat"}} <i class="kind">{{.Kind}}</i>{{end}}</div><div class="m-content">{{.Content}}</div></div>{{end}}
{{define "participants"}}<div id="participants"><h3>Participants</h3><ul>{{range .}}<li class="{{if .LastSeenAt}}p-online{{else}}p-offline{{end}}"{{if or .Hostname .Workdir}} title="{{if .Hostname}}{{.Hostname}} · {{end}}{{.Workdir}}"{{end}}><span class="id">{{.DisplayName}}</span>{{if .Workdir}}<small>{{.Workdir}}</small>{{end}}</li>{{else}}<li>none</li>{{end}}</ul></div>{{end}}
