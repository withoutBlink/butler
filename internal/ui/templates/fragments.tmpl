{{define "message"}}<div class="msg {{.Kind}}" data-seq="{{.Seq}}" data-sender="{{.SenderID}}"><div class="m-content"><span class="m-meta">[{{.Seq}} {{ts .CreatedAt}}] <b title="{{.SenderID}}">{{if .SenderName}}{{.SenderName}}{{else}}{{.SenderID}}{{end}}</b>{{if ne .Kind "chat"}} <i class="kind">{{.Kind}}</i>{{end}}</span>{{if .ReadTotal}}<span class="m-read{{if eq .ReadCount .ReadTotal}} all{{end}}" title="{{.Readers}}">✓{{.ReadCount}}/{{.ReadTotal}}</span>{{end}} {{.Content}}</div></div>{{end}}
{{define "participants"}}<div id="participants"><h3>Participants</h3><ul>{{range .}}<li class="{{if agentOnline .}}p-online{{else}}p-offline{{end}}"{{if or .Hostname .Workdir}} title="{{if .Hostname}}{{.Hostname}} · {{end}}{{.Workdir}}"{{end}}><span class="id">{{.DisplayName}}</span>{{if .Workdir}}<small>{{.Workdir}}</small>{{end}}</li>{{else}}<li>none</li>{{end}}</ul></div>{{end}}
