# Butler reverse proxy example (nginx)
#
# Butler serves plain HTTP on 127.0.0.1:8787 by default. Terminate TLS here if
# you expose Butler to the internet; token auth protects the API either way.
#
# Two settings are load-bearing:
#   proxy_buffering off  — long-poll (/api/v1/wait) and future SSE responses
#                          must not be buffered or delivery stalls
#   proxy_read_timeout   — must exceed the agents' wait timeout (default 25s);
#                          nginx's 60s default is fine, anything under 30s
#                          will 504 every poll

server {
    listen 443 ssl;
    server_name butler.example.com;

    # ssl_certificate     /etc/letsencrypt/live/butler.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/butler.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_read_timeout 35s;
        proxy_send_timeout 35s;
    }
}

# Optional: plain HTTP redirect
server {
    listen 80;
    server_name butler.example.com;
    return 301 https://$host$request_uri;
}
