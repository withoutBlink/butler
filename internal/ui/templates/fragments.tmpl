{{define "message"}}<div class="msg {{.Kind}}" data-seq="{{.Seq}}"><span class="m-meta">[{{.Seq}} {{ts .CreatedAt}}] <b>{{.SenderID}}</b>{{if ne .Kind "chat"}} <i class="kind">{{.Kind}}</i>{{end}}</span> <span class="m-content">{{.Content}}</span></div>{{end}}
{{define "participants"}}<div id="participants"><h3>Participants</h3><ul>{{range .}}<li class="{{if .LastSeenAt}}p-online{{else}}p-offline{{end}}">{{.DisplayName}} <small>({{.Kind}})</small></li>{{else}}<li>none</li>{{end}}</ul></div>{{end}}
